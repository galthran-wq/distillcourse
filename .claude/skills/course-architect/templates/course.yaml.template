schema_version: 1
slug: <kebab-case>
title: <Course title>
tagline: <One factual line naming what the course covers>
status: planned
audience: >
  <Who this is for, what they already know, what they want. Consumed by
  lesson-author as a writing brief.>
tone: <Voice notes for lesson-author; the register is always dry/engineering>
intro: >
  <2 short markdown paragraphs: the overall idea of the course, then the
  scope — what is covered and what is explicitly out of scope.>
prerequisites:
  - text: <What the reader needs before starting>
    # course: <other-course-slug>   # optional link to another course
key_results:
  - text: <A headline theorem/fact of the course, stated precisely>
    lesson: <lesson-slug>           # the lesson that establishes it
sources:
  - <Main source used to compile the course, full citation>
outcomes:
  - id: co-<slug>
    text: <What the learner can DO afterwards — starts with a Bloom verb>
    bloom: <remember|understand|apply|analyze|evaluate|create>

modules:
  - slug: <kebab-case>
    title: "<Module title>"
    outcomes: [co-<slug>]          # every course outcome claimed by >=1 module
    lessons:
      - slug: <kebab-case>          # immutable once status >= drafted
        title: "<Technical noun phrase naming the content (C6)>"
        type: core                  # core | worked-practice | synthesis | review
        status: planned             # architect always writes planned
        goal: "<ONE objective, starts with a Bloom verb>"
        opening: "<Declarative statement of the problem this lesson solves — used verbatim as the first sentence>"
        est_minutes: 12             # reading time guidance; 5-45
        prerequisites: []           # earlier lesson slugs only (acyclic)
        concepts:
          introduces: [<concept-id>]
          reinforces: []            # spiral revisits — visible here
        key_ideas:                  # 2-5; the author's plan, not a section list
          - <micro-idea one>
          - <micro-idea two>
        demo: null                  # or: {component: PascalCase, spec: >-, ...}

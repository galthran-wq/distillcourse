# Copy to .env. docker compose reads it for both substitution and the services.
ENVIRONMENT=local

# Postgres. Change the password before anything but ENVIRONMENT=local: the
# backend refuses to start on the default outside local.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=distillcourse
POSTGRES_PORT=5432

# caddy. SITE_ADDRESS is a Caddy site address: ":80" serves plain HTTP, a
# hostname makes Caddy obtain and renew a certificate for it on its own.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Frontend build: 1 renders drafted + reviewed lessons, 0 published only.
CONTENT_PREVIEW=1
FRONTEND_HOST=http://localhost

# Signup is invite-only — hand this string to whoever should get an account.
# Like the Postgres password, the default is rejected outside ENVIRONMENT=local.
INVITE_CODE=local-invite

# Observability. Empty means traces stay local instead of failing to start.
LOGFIRE_TOKEN=

# The tutor talks to models through OpenRouter only; the backend refuses to
# start without a key outside local. Give the key a spend limit in the
# OpenRouter dashboard: the ceiling below is the software half of the budget,
# that limit is the half nothing in this repo can bypass.
OPENROUTER_API_KEY=
MONTHLY_COST_CEILING_USD=50

# Copy to .env. docker compose reads it for both substitution and the services.
ENVIRONMENT=local

# Postgres. Change the password before anything but ENVIRONMENT=local: the
# backend refuses to start on the default outside local.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=distillcourse
POSTGRES_PORT=5432

# caddy. SITE_ADDRESS is a Caddy site address: ":80" serves plain HTTP, a
# hostname makes Caddy obtain and renew a certificate for it on its own.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Frontend build: 1 renders drafted + reviewed lessons, 0 published only.
CONTENT_PREVIEW=1
FRONTEND_HOST=http://localhost

# Observability. Empty means traces stay local instead of failing to start.
LOGFIRE_TOKEN=

# The tutor talks to models through OpenRouter only; the backend refuses to
# start without a key outside local. Give the key a spend limit in the
# OpenRouter dashboard: the ceiling below is the software half of the budget,
# that limit is the half nothing in this repo can bypass.
OPENROUTER_API_KEY=
MONTHLY_COST_CEILING_USD=50

# The Telegram bot: the token BotFather issued, the @name without the @, and a
# secret of your own that Telegram echoes back on every webhook call (any long
# random string). All three empty is a working configuration: the channel does
# not exist, the site offers no pairing, and the platform never writes first.
# After deploying, register the URL once:
#   docker compose exec backend python -m app.cli set-webhook \
#     https://<your host>/api/tg/webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# The tutor's web search (Perplexity). Empty is a working configuration: the
# search tool reports itself unavailable and the tutor answers from the
# courses. The cap is per user per day.
PERPLEXITY_API_KEY=
WEB_SEARCH_DAILY_CAP=20

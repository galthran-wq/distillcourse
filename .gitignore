# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.preview/
__pycache__/
*.py[cod]

# generated by apps/frontend/scripts/sync-assets.ts from
# content/courses/*/lessons/*/figures/
/apps/frontend/public/course-assets/

# raw source material cached by the reading swarm (fetched books, PDFs,
# extracted text) — local working copies only, never committed or published
content/courses/*/research/texts/

# temporary source PDFs staged beside extracted research images
content/courses/*/research/images/.*.pdf

# the student notebook of a lab lesson: generated from solution.py by the
# lab build, never hand-written and never committed
content/courses/*/lessons/*/lab.ipynb

# git worktrees live here; never content of the outer repo
/.claude/worktrees/

# python
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
apps/backend/.venv/
apps/lab-client/.venv/

# database dumps written by the backup container
/backups/

# search index written by `npm run export-index`, consumed by the backend's
# ingest CLI — a build artefact of content/, never a source of truth
/index.json

# lab build artefacts written by `npm run build-labs`: the public half goes to
# the mirror, the private half to the checkpoint API, and .venvs/ caches each
# lab's locked environment
/labs-dist/
# what assemble.sh builds when run locally; CI assembles it on the runner
/mirror-tree/

{
  "name": "distillcourse-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run sync-assets",
    "dev": "next dev",
    "prebuild": "npm run sync-assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prevalidate": "npm run sync-assets",
    "validate": "tsx --conditions=import scripts/validate.ts",
    "export-index": "tsx --conditions=import scripts/export-index.ts",
    "build-labs": "tsx scripts/build-labs.ts",
    "figure": "tsx scripts/render-figure.ts",
    "preview": "node scripts/fix-oxide-binding.mjs && tsx --conditions=import scripts/preview-lesson.tsx",
    "sync-assets": "tsx scripts/sync-assets.ts",
    "image": "tsx scripts/image.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.245",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.11",
    "@types/mdx": "^2.0.14",
    "ai": "^6.0.243",
    "css-tree": "^3.2.1",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.18.1",
    "mdast-util-to-string": "^4.0.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.4",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-stringify": "^11.0.0",
    "server-only": "^0.0.1",
    "shiki": "^4.3.1",
    "svgo": "^4.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/css-tree": "^3.2.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "katex": "$katex"
  }
}

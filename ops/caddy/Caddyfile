# SITE_ADDRESS is a Caddy site address: ":80" serves plain HTTP, a hostname
# makes Caddy obtain and renew a certificate for it on its own.
{$SITE_ADDRESS} {
	# Telemetry is the one endpoint a reader's browser posts to unprompted, so
	# its ceiling is enforced here too: the route checks Content-Length, this
	# also covers a body that declares none. Kept above the largest batch
	# app/telemetry/schemas.py accepts (MAX_BATCH_BYTES, ~112KB).
	handle /api/v1/telemetry/* {
		request_body {
			max_size 128KB
		}
		reverse_proxy backend:8000
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}

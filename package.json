{
  "name": "distillcourse",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo root. The frontend keeps its own package.json and node_modules under apps/frontend; these scripts are proxies so the authoring loop still runs from the repo root.",
  "scripts": {
    "dev": "npm --prefix apps/frontend run dev",
    "build": "npm --prefix apps/frontend run build",
    "start": "npm --prefix apps/frontend run start",
    "lint": "npm --prefix apps/frontend run lint",
    "test": "npm --prefix apps/frontend run test",
    "validate": "npm --prefix apps/frontend run validate",
    "figure": "npm --prefix apps/frontend run figure",
    "preview": "npm --prefix apps/frontend run preview",
    "sync-assets": "npm --prefix apps/frontend run sync-assets",
    "image": "npm --prefix apps/frontend run image",
    "install:frontend": "npm --prefix apps/frontend install"
  }
}
